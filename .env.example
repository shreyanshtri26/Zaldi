# Google AI API Key for Gemini models
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key for fast inference
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Token required by the admin panel / CMS write endpoints (choose a long random string)
ADMIN_TOKEN=change-me

# Signs checkout confirmation tokens (defaults to ADMIN_TOKEN). Use a long random string in production.
SECRET_KEY=change-me-too

# Optional overrides
# EMBEDDING_PROVIDER=local   # offline hashing embeddings (default when no GOOGLE_API_KEY): lexical matching only
# STOREFRONT_URL=            # checkout site the browser automation drives (default: the built-in demo store)
# BROWSER_CHANNEL=msedge     # use an installed Edge/Chrome instead of Playwright's Chromium
# LLM_PROVIDER=google        # or groq (then LLM_MODEL=openai/gpt-oss-120b)
# LLM_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=models/gemini-embedding-001
